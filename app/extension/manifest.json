{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Fetchline"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Send links and downloads from your browser to Fetchline, the desktop download manager, with one click.",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Fetchline",
  "permissions": [
    "activeTab",
    "contextMenus",
    "cookies",
    "downloads",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "fetchline@fetchline.app"
    }
  }
}
