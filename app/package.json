{
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "name": "fetchline-ui",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:extension": "python3 extension/tests/validate_manifest.py && python3 extension/tests/validate_host_manifest.py",
    "test:extension-content": "node --test extension/tests/content.test.js",
    "test:extension-video": "node --test extension/tests/video-detect.test.js",
    "test:extension-popup": "node --test extension/tests/popup.test.js",
    "test:extension-background": "node --test extension/tests/background.test.js",
    "test:extension-watcher": "node --test extension/tests/watcher.test.js",
    "test:speed-graph": "node --test src/lib/speedGraph.test.mjs",
    "test:ui": "vitest run"
  },
  "type": "module",
  "version": "0.1.0"
}
